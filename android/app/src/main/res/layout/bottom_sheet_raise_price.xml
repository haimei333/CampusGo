<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="24dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_sheet_handle" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="12dp"
        android:text="@string/raise_title"
        android:textColor="@color/cg_text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvRaiseHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="4dp"
        android:paddingBottom="8dp"
        android:text="@string/raise_hint"
        android:textColor="@color/cg_text_secondary"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="20dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/chipRaise3"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_raise_chip_selected"
            android:gravity="center"
            android:text="@string/raise_amount_3"
            android:textColor="@color/cg_brand"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/chipRaise5"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_raise_chip"
            android:gravity="center"
            android:text="@string/raise_amount_5"
            android:textColor="@color/cg_text_secondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/chipRaise10"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/bg_raise_chip"
            android:gravity="center"
            android:text="@string/raise_amount_10"
            android:textColor="@color/cg_text_secondary"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/btnConfirmRaise"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/bg_btn_primary_brand"
        android:gravity="center"
        android:text="@string/raise_confirm"
        android:textColor="@color/cg_text_on_brand"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/btnDismiss"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="12dp"
        android:text="@string/cancel_dismiss"
        android:textColor="@color/cg_text_tertiary"
        android:textSize="14sp" />
</LinearLayout>
